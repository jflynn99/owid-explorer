# All of this is OPTIONAL and only used by the agent + chart chat.
# Charts, search and overlays work with no configuration at all.

# There are two ways to fund the AI features. Pick one.
#
# 1. Public site (recommended): set ONLY an API key below and leave
#    LLM_PROVIDER commented out. Your key then pays for the quota-limited
#    "Ask about this chart" panel and nothing else; the full agent page asks
#    each visitor for their own key.
#
# 2. Private fork: also set LLM_PROVIDER. The FULL agent then runs on your
#    key for anyone who can reach the site, with no quota. Do not do this on
#    a public deployment.
#
# 'anthropic' | 'openai' | 'ollama'
# LLM_PROVIDER=anthropic

# Optional model override (defaults: claude-haiku-5-5 / gpt-4o-mini / llama3.1)
# LLM_MODEL=

# Provide the key matching your provider (fork mode). In the hosted demo,
# visitors can instead paste a key in the UI; it stays in localStorage and is
# sent per-request, never logged or persisted server-side.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ollama (fork mode only — the hosted demo can't reach your localhost).
# Never sourced from client headers.
OLLAMA_BASE_URL=http://localhost:11434

# --- "Ask about this chart" (server-funded chat on chart pages) ---
# Enabled whenever ANTHROPIC_API_KEY or OPENAI_API_KEY is set (LLM_PROVIDER not
# required). Free questions per visitor per UTC day, tracked in a signed
# cookie. 0 disables the feature. Default 5.
# CHART_CHAT_DAILY_LIMIT=5

# Free questions across ALL visitors per UTC day; once reached, the panel
# rests until tomorrow. Default 200. 0 removes the site-wide cap.
# CHART_CHAT_GLOBAL_DAILY_LIMIT=200
#
# The site-wide count is only truly site-wide with a shared store. Add an
# Upstash Redis / Vercel KV integration and these appear automatically
# (either naming works). Without them each server instance counts on its own.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
#
# Whatever you set here, also put a monthly spend limit on the key itself in
# your provider's console. That is the limit that cannot be worked around.

# Secret for signing the quota cookie. Optional — defaults to a hash derived
# from your API key. Set explicitly if you rotate keys and want quotas to
# survive the rotation.
# CHAT_QUOTA_SECRET=
